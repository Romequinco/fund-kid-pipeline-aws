# Copiar a .env (no se versiona) para ejecutar scripts/pipeline.py en local tras `aws login`.
# Ninguno es un secreto: la contraseña de la base de datos está en Secrets Manager (D-0.4).
# Los valores salen de `terraform -chdir=infra/main output`.
AWS_REGION=eu-west-3
KID_BUCKET=fund-kid-<alias>-documentos
DB_CLUSTER_ARN=arn:aws:rds:<region>:<cuenta>:cluster:fund-kid
DB_SECRET_ARN=arn:aws:secretsmanager:<region>:<cuenta>:secret:rds!cluster-...
DB_NAME=kid
BEDROCK_MODEL_ID=
